# Fake placeholders only. Copy this file to .env for local work.
# .env is gitignored. Put the real values in Vercel project settings, not in Git.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# APP_URL: Public site URL. Checkout uses the request host when it has one.
# This value is only the fallback for return links.
APP_URL="https://YOUR_APP_URL"

# JWT_SECRET: Key for signing admin JWT tokens.
JWT_SECRET="YOUR_JWT_SECRET_HERE"

# STRIPE_SECRET_KEY: Stripe secret key. Test mode is the default.
# The server creates Checkout sessions only for keys that start with sk_test_,
# unless STRIPE_ALLOW_LIVE=true is set.
#
# Get a test key:
# 1. Open https://dashboard.stripe.com and turn Test mode on (toggle in the dashboard).
# 2. Go to Developers → API keys: https://dashboard.stripe.com/test/apikeys
# 3. Copy the Secret key. It starts with sk_test_.
# 4. Put the real key in a local .env file (gitignored). Do not commit it.
#
# On Stripe's hosted payment page, pay with test card 4242 4242 4242 4242,
# any future expiry date, and any CVC. That card never creates a real charge.
#
# Delivery is only within Panama. Checkout collects that address on the shop
# form. Do not enable Stripe shipping-address collection in the Dashboard or
# in code: the customer would be asked for an address twice.
STRIPE_SECRET_KEY="sk_test_REPLACE_WITH_YOUR_TEST_KEY"

# STRIPE_ALLOW_LIVE: Leave unset for test mode. Set to true only if you
# intentionally use an sk_live_ key and accept real charges.
# STRIPE_ALLOW_LIVE="true"

# STRIPE_WEBHOOK_SECRET: Signing secret for POST /api/stripe/webhook.
# The server checks Stripe's signature before it marks an order paid or lowers stock.
# For local testing, copy the whsec_ value printed by:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# Put the real value in .env only. This placeholder is not a real secret.
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"

# Admin login. Do not put a real password in this file.
# Create or replace the hash with:
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD='choose-a-long-password' npm run admin:set-password
# Print a hash only, for a SQL update you run yourself:
#   ADMIN_PASSWORD='choose-a-long-password' npm run admin:set-password -- --print-hash
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# RESEND_API_KEY: Resend API key used only by POST /api/admin/email.
# When this is unset, that endpoint returns 503 "email not configured" and sends nothing.
# Put the real key in .env or in Vercel. This placeholder is not a real secret.
RESEND_API_KEY=re_REPLACE_ME

# EMAIL_FROM: The From address Resend is allowed to send as.
# Example shape: Shop Name <orders@your-domain.com>
EMAIL_FROM="Shop Name <orders@example.com>"
