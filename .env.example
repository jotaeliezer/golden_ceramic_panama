# Required for local/dev and production. The server loads this file with dotenv
# and refuses to start if JWT_SECRET is missing or empty.
# Use a long random string. Do not commit the real secret.
JWT_SECRET="YOUR_JWT_SECRET_HERE"

# APP_URL: Public URL of this app. Used for checkout return links.
# Defaults to http://localhost:3000 when unset.
APP_URL="http://localhost:3000"

# STRIPE_SECRET_KEY: Stripe secret key used at checkout.
STRIPE_SECRET_KEY="sk_test_..."
